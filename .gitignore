benchmarks/raw/*
proofs/private/*
releases/*
presults.txt

# Keep directory documentation/placeholders
!checkpoints/.gitkeep
!coverage/.gitkeep
!benchmarks/raw/.gitkeep
!proofs/private/.gitkeep
!releases/.gitkeep

