+// A radix-256 global sweep keeps the same four-way scan primitive as the
+// validated radix-64 path.  This variant uses 128 threads and emits two roots
+// per work-group; the global reduction factor remains 256.  At transform
+// length 262144 this reduces the division scan from five global synchronization
+// points to three.  The final root array starts at 425 * s so it can be reused
+// in-place as the next level, exactly like the radix-64 layout at 105 * s.
+#define R256_WG 128
+#define R256_L2 (R256_WG + 5 * (R256_WG / 4))
+#define R256_L3 (R256_L2 + 5 * (R256_WG / 16))
+#define R256_L4 (R256_L3 + 5 * (R256_WG / 64))
+#define R256_LOCAL_SIZE (R256_L4 + (R256_WG / 64))
+
+__kernel __attribute__((reqd_work_group_size(R256_WG, 1, 1)))
+void reduce_upsweep256(__global uint * restrict const t_base, const uint s, const uint j,
+	__global const candidate_params_t * restrict const candidate_params_base)
+{
+	const size_t lane = get_global_id(1);
+	__global uint * const t = t_base + lane * pconst_size;
+	__global const candidate_params_t * const candidate_params = candidate_params_base + lane;
+	__local uint T[R256_LOCAL_SIZE];
+
+	const size_t i = get_local_id(0), blk = get_group_id(0);
+	__global uint * const tj = &t[j];
+	_reduce_upsweep4i(T, &tj[4 * R256_WG * blk], R256_WG, i, candidate_params);
+	barrier(CLK_LOCAL_MEM_FENCE);
+	if (i < R256_WG / 4) _reduce_upsweep4(&T[R256_WG], R256_WG / 4, i, candidate_params);
+	barrier(CLK_LOCAL_MEM_FENCE);
+	if (i < R256_WG / 16) _reduce_upsweep4(&T[R256_L2], R256_WG / 16, i, candidate_params);
+	barrier(CLK_LOCAL_MEM_FENCE);
+	if (i < R256_WG / 64) _reduce_upsweep4(&T[R256_L3], R256_WG / 64, i, candidate_params);
+	barrier(CLK_LOCAL_MEM_FENCE);
+
+	const size_t k256 = blk * R256_WG + i;
+	tj[256 * s + k256] = T[i];
+	tj[320 * s + k256] = T[R256_WG + i];
+	if (i < R256_WG / 4)
+	{
+		const size_t k64 = blk * (R256_WG / 4) + i;
+		tj[384 * s + k64] = T[R256_WG + 4 * (R256_WG / 4) + i];
+		tj[400 * s + k64] = T[R256_L2 + i];
+	}
+	if (i < R256_WG / 16)
+	{
+		const size_t k16 = blk * (R256_WG / 16) + i;
+		tj[416 * s + k16] = T[R256_L2 + 4 * (R256_WG / 16) + i];
+		tj[420 * s + k16] = T[R256_L3 + i];
+	}
+	if (i < R256_WG / 64)
+	{
+		const size_t k4 = blk * (R256_WG / 64) + i;
+		tj[424 * s + k4] = T[R256_L3 + 4 * (R256_WG / 64) + i];
+		tj[425 * s + k4] = T[R256_L4 + i];
+	}
+}
+
+__kernel __attribute__((reqd_work_group_size(R256_WG, 1, 1)))
+void reduce_upsweep256_i(__global const uint2 * restrict const x_base,
+	__global uint * restrict const y_base, __global uint * restrict const t_base,
+	__global const uint * restrict const bp_base, __global int * restrict const err_base,
+	const uint s, const uint j,
+	__global const candidate_params_t * restrict const candidate_params_base)
+{
+	const size_t lane = get_global_id(1);
+	__global const uint2 * const x = x_base + lane * pconst_size;
+	__global uint * const y = y_base + lane * (pconst_size / 2);
+	__global uint * const t = t_base + lane * pconst_size;
+	__global const uint * const bp = bp_base + lane * (pconst_size / 2);
+	__global int * const err = err_base + 2 * lane;
+	__global const candidate_params_t * const candidate_params = candidate_params_base + lane;
+	__local uint T[R256_LOCAL_SIZE];
+
+	const size_t i = get_local_id(0), blk = get_group_id(0), k = get_global_id(0);
+	__global uint * const tj = &t[j];
+	const size_t digit = 4 * k;
+#if PRIMEFORGE_FUSE_POLY2INT_FIX
+	const bool needs_fix = err[1] != 0;
+#else
+	const bool needs_fix = false;
+#endif
+	const uint xd0 = _poly2int_fixed_digit(x, pconst_e + digit + 0, needs_fix);
+	const uint xd1 = _poly2int_fixed_digit(x, pconst_e + digit + 1, needs_fix);
+	const uint xd2 = _poly2int_fixed_digit(x, pconst_e + digit + 2, needs_fix);
+	const uint xd3 = _poly2int_fixed_digit(x, pconst_e + digit + 3, needs_fix);
+	const uint xd4 = _poly2int_fixed_digit(x, pconst_e + digit + 4, needs_fix);
+	const uint xs0 = ((xd0 >> pconst_s) | (xd1 << (digit_bit - pconst_s))) & digit_mask;
+	const uint xs1 = ((xd1 >> pconst_s) | (xd2 << (digit_bit - pconst_s))) & digit_mask;
+	const uint xs2 = ((xd2 >> pconst_s) | (xd3 << (digit_bit - pconst_s))) & digit_mask;
+	const uint xs3 = ((xd3 >> pconst_s) | (xd4 << (digit_bit - pconst_s))) & digit_mask;
+	const uint4 u = (uint4)(
+		rem_d(xs0 * (ulong)(bp[digit + 0])),
+		rem_d(xs1 * (ulong)(bp[digit + 1])),
+		rem_d(xs2 * (ulong)(bp[digit + 2])),
+		rem_d(xs3 * (ulong)(bp[digit + 3])));
+	y[digit + 0] = xs0; y[digit + 1] = xs1; y[digit + 2] = xs2; y[digit + 3] = xs3;
+	if (k == 0) t[1] = _poly2int_fixed_digit(x, pconst_e, needs_fix) & ((1u << pconst_s) - 1);
+
+	((__global uint4 *)tj)[k] = u;
+	const uint u01 = addmod_d(u.s0, u.s1), u23 = addmod_d(u.s2, u.s3);
+	T[i] = u23;
+	T[R256_WG + i] = addmod_d(u01, u23);
+	barrier(CLK_LOCAL_MEM_FENCE);
+	if (i < R256_WG / 4) _reduce_upsweep4(&T[R256_WG], R256_WG / 4, i, candidate_params);
+	barrier(CLK_LOCAL_MEM_FENCE);
+	if (i < R256_WG / 16) _reduce_upsweep4(&T[R256_L2], R256_WG / 16, i, candidate_params);
+	barrier(CLK_LOCAL_MEM_FENCE);
+	if (i < R256_WG / 64) _reduce_upsweep4(&T[R256_L3], R256_WG / 64, i, candidate_params);
+	barrier(CLK_LOCAL_MEM_FENCE);
+
+	const size_t k256 = blk * R256_WG + i;
+	tj[256 * s + k256] = T[i];
+	tj[320 * s + k256] = T[R256_WG + i];
+	if (i < R256_WG / 4)
+	{
+		const size_t k64 = blk * (R256_WG / 4) + i;
+		tj[384 * s + k64] = T[R256_WG + 4 * (R256_WG / 4) + i];
+		tj[400 * s + k64] = T[R256_L2 + i];
+	}
+	if (i < R256_WG / 16)
+	{
+		const size_t k16 = blk * (R256_WG / 16) + i;
+		tj[416 * s + k16] = T[R256_L2 + 4 * (R256_WG / 16) + i];
+		tj[420 * s + k16] = T[R256_L3 + i];
+	}
+	if (i < R256_WG / 64)
+	{
+		const size_t k4 = blk * (R256_WG / 64) + i;
+		tj[424 * s + k4] = T[R256_L3 + 4 * (R256_WG / 64) + i];
+		tj[425 * s + k4] = T[R256_L4 + i];
+	}
+}
+
+__kernel __attribute__((reqd_work_group_size(R256_WG, 1, 1)))
+void reduce_downsweep256(__global uint * restrict const t_base, const uint s, const uint j,
+	__global const candidate_params_t * restrict const candidate_params_base)
+{
+	const size_t lane = get_global_id(1);
+	__global uint * const t = t_base + lane * pconst_size;
+	__global const candidate_params_t * const candidate_params = candidate_params_base + lane;
+	__local uint T[R256_LOCAL_SIZE];
+
+	const size_t i = get_local_id(0), blk = get_group_id(0);
+	__global uint * const tj = &t[j];
+	const size_t k256 = blk * R256_WG + i;
+	T[i] = tj[256 * s + k256];
+	T[R256_WG + i] = tj[320 * s + k256];
+	if (i < R256_WG / 4)
+	{
+		const size_t k64 = blk * (R256_WG / 4) + i;
+		T[R256_WG + 4 * (R256_WG / 4) + i] = tj[384 * s + k64];
+		T[R256_L2 + i] = tj[400 * s + k64];
+	}
+	if (i < R256_WG / 16)
+	{
+		const size_t k16 = blk * (R256_WG / 16) + i;
+		T[R256_L2 + 4 * (R256_WG / 16) + i] = tj[416 * s + k16];
+		T[R256_L3 + i] = tj[420 * s + k16];
+	}
+	if (i < R256_WG / 64)
+	{
+		const size_t k4 = blk * (R256_WG / 64) + i;
+		T[R256_L3 + 4 * (R256_WG / 64) + i] = tj[424 * s + k4];
+		T[R256_L4 + i] = tj[425 * s + k4];
+	}
+	barrier(CLK_LOCAL_MEM_FENCE);
+	if (i < R256_WG / 64) _reduce_downsweep4(&T[R256_L3], R256_WG / 64, i, candidate_params);
+	barrier(CLK_LOCAL_MEM_FENCE);
+	if (i < R256_WG / 16) _reduce_downsweep4(&T[R256_L2], R256_WG / 16, i, candidate_params);
+	barrier(CLK_LOCAL_MEM_FENCE);
+	if (i < R256_WG / 4) _reduce_downsweep4(&T[R256_WG], R256_WG / 4, i, candidate_params);
+	barrier(CLK_LOCAL_MEM_FENCE);
+	_reduce_downsweep4o(&tj[4 * R256_WG * blk], T, R256_WG, i, candidate_params);
+}
+
+__kernel __attribute__((reqd_work_group_size(R256_WG, 1, 1)))
+void reduce_downsweep256_o(__global uint2 * restrict const x_base,
+	__global const uint * restrict const y_base, __global uint * restrict const t_base,
+	__global const uint * restrict const ibp_base, const uint s, const uint j,
+	__global const candidate_params_t * restrict const candidate_params_base)
+{
+	const size_t lane = get_global_id(1);
+	__global uint2 * const x = x_base + lane * pconst_size;
+	__global const uint * const y = y_base + lane * (pconst_size / 2);
+	__global uint * const t = t_base + lane * pconst_size;
+	__global const uint * const ibp = ibp_base + lane * (pconst_size / 2);
+	__global const candidate_params_t * const candidate_params = candidate_params_base + lane;
+	__local uint T[R256_LOCAL_SIZE];
+
+	const size_t i = get_local_id(0), blk = get_group_id(0), k = get_global_id(0);
+	__global uint * const tj = &t[j];
+	const size_t k256 = blk * R256_WG + i;
+	T[i] = tj[256 * s + k256];
+	T[R256_WG + i] = tj[320 * s + k256];
+	if (i < R256_WG / 4)
+	{
+		const size_t k64 = blk * (R256_WG / 4) + i;
+		T[R256_WG + 4 * (R256_WG / 4) + i] = tj[384 * s + k64];
+		T[R256_L2 + i] = tj[400 * s + k64];
+	}
+	if (i < R256_WG / 16)
+	{
+		const size_t k16 = blk * (R256_WG / 16) + i;
+		T[R256_L2 + 4 * (R256_WG / 16) + i] = tj[416 * s + k16];
+		T[R256_L3 + i] = tj[420 * s + k16];
+	}
+	if (i < R256_WG / 64)
+	{
+		const size_t k4 = blk * (R256_WG / 64) + i;
+		T[R256_L3 + 4 * (R256_WG / 64) + i] = tj[424 * s + k4];
+		T[R256_L4 + i] = tj[425 * s + k4];
+	}
+	barrier(CLK_LOCAL_MEM_FENCE);
+	if (i < R256_WG / 64) _reduce_downsweep4(&T[R256_L3], R256_WG / 64, i, candidate_params);
+	barrier(CLK_LOCAL_MEM_FENCE);
+	if (i < R256_WG / 16) _reduce_downsweep4(&T[R256_L2], R256_WG / 16, i, candidate_params);
+	barrier(CLK_LOCAL_MEM_FENCE);
+	if (i < R256_WG / 4) _reduce_downsweep4(&T[R256_WG], R256_WG / 4, i, candidate_params);
+	barrier(CLK_LOCAL_MEM_FENCE);
+
+	__global const uint4 * const input = (__global const uint4 *)&tj[4 * R256_WG * blk];
+	const uint u2 = T[i], u0 = T[R256_WG + i], u02 = addmod_d(u0, u2);
+	const uint4 u13 = input[i];
+	const uint4 out = (uint4)(addmod_d(u02, u13.s1), u02, addmod_d(u0, u13.s3), u0);
+	const ulong final_value = ((ulong)(t[0]) << pconst_s) | t[1];
+	const size_t digit = 4 * k;
+	_reduce_o_digit(x, y, ibp, digit + 0, out.s0, final_value, candidate_params);
+	_reduce_o_digit(x, y, ibp, digit + 1, out.s1, final_value, candidate_params);
+	_reduce_o_digit(x, y, ibp, digit + 2, out.s2, final_value, candidate_params);
+	_reduce_o_digit(x, y, ibp, digit + 3, out.s3, final_value, candidate_params);
+}
