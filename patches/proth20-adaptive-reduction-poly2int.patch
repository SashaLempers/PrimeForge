+		const size_t k_4 = blk * R64 / 4 + i;
+		__global const uint4 * const tj4_4 = (__global uint4 *)&tj[5 * (16 * s)];
+		const uint u2 = tj[5 * (16 * s) + 4 * (4 * s) + k_4], u0 = T_2[i], u02 = addmod_d(u0, u2);
