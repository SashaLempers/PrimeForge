+inline uint _poly2int_fixed_digit(__global const uint2 * restrict const x, const size_t k, const bool needs_fix)
+{
+#if PRIMEFORGE_FUSE_POLY2INT_FIX
+	if (!needs_fix) return x[k].s0;
+
+	int f = 0;
+	uint digit = 0;
+	for (size_t i = 0; i <= k; ++i)
+	{
+		f += x[i].s0;
+		digit = (uint)(f) & digit_mask;
+		f >>= digit_bit;
+	}
+	return digit;
+#else
+	(void)needs_fix;
+	return x[k].s0;
+#endif
+}
+
+inline void _poly2int_fix_serial(__global uint2 * restrict const x, __global int * restrict const err)
+{
+#if PRIMEFORGE_FUSE_POLY2INT_FIX
+	if (err[1] == 0) return;
+
+	int f = 0;
+	for (size_t k = 0; k < pconst_size; ++k)
+	{
+		f += x[k].s0;
+		x[k].s0 = (uint)(f) & digit_mask;
+		f >>= digit_bit;
+	}
+	err[0] = f;
+	err[1] = 0;
+#else
+	(void)x;
+	(void)err;
+#endif
+}
