+	const uint xd0 = _poly2int_fixed_digit(x, pconst_e + digit + 0, needs_fix);
+	const uint xd1 = _poly2int_fixed_digit(x, pconst_e + digit + 1, needs_fix);
+	const uint xd2 = _poly2int_fixed_digit(x, pconst_e + digit + 2, needs_fix);
+	const uint xd3 = _poly2int_fixed_digit(x, pconst_e + digit + 3, needs_fix);
+	const uint xd4 = _poly2int_fixed_digit(x, pconst_e + digit + 4, needs_fix);
+	const uint xs0 = ((xd0 >> pconst_s) | (xd1 << (digit_bit - pconst_s))) & digit_mask;
+	const uint xs1 = ((xd1 >> pconst_s) | (xd2 << (digit_bit - pconst_s))) & digit_mask;
+	const uint xs2 = ((xd2 >> pconst_s) | (xd3 << (digit_bit - pconst_s))) & digit_mask;
+	const uint xs3 = ((xd3 >> pconst_s) | (xd4 << (digit_bit - pconst_s))) & digit_mask;
+	const uint4 u = (uint4)(
+		rem_d(xs0 * (ulong)(bp[digit + 0])),
+		rem_d(xs1 * (ulong)(bp[digit + 1])),
+		rem_d(xs2 * (ulong)(bp[digit + 2])),
