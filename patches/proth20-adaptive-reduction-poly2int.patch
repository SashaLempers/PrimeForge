+inline void _reduce_o_digit(__global uint2 * restrict const x, __global const uint * restrict const y,
+	__global const uint * restrict const ibp, const size_t k, const uint tk, const ulong final_value,
+	__global const candidate_params_t * restrict const candidate_params)
+{
+	const uint mask = (k != pconst_size / 2 - 1) ? (uint)(-1) : 0;
+	const uint r_prev = rem_d((tk & mask) * (ulong)(ibp[k]));
+	const ulong q = ((ulong)(r_prev) << digit_bit) | y[k];
+	const uint q_d = mul_hi((uint)(q >> candidate_params->d_shift), candidate_params->d_inv);
+	const uint r = (uint)(q) - q_d * candidate_params->d;
+	const uint c = (r >= candidate_params->d) ? 1 : 0;
+	uint final_digit = (k < pconst_e) ? x[k].s0 : 0;
+	if (k >= pconst_e)
+	{
+		const size_t shift = (k - pconst_e) * digit_bit;
+		if (shift < 8 * sizeof(ulong)) final_digit = (uint)(final_value >> shift) & digit_mask;
+	}
+	x[k] = (uint2)(final_digit, q_d + c);
+}
