+		planMarker << "PRIMEFORGE_NATIVE_BATCH_PLAN\t" << X.getPlanString() << std::endl;
+		pio::print(planMarker.str());
+
+		const std::chrono::steady_clock::time_point preparationStart = std::chrono::steady_clock::now();
+		std::vector<std::vector<cl_uint2>> initialStates(batchKs.size());
+		for (size_t lane = 0; lane < batchKs.size(); ++lane)
+		{
+			X.selectScalarPreparationCandidate(batchKs[lane]);
+			if (!apowk(X, witnesses[lane], batchKs[lane])) return false;
+			checkError(X);
+			X.readMainState(initialStates[lane]);
+		}
+		X.activateNativeBatch(batchKs, initialStates);
+		const double preparationSeconds = std::chrono::duration<double>(
+			std::chrono::steady_clock::now() - preparationStart).count();
+
+		const uint32_t L = 1 << (arith::log2(n) / 2);
+		const std::chrono::steady_clock::time_point mainStart = std::chrono::steady_clock::now();
+		for (uint32_t i = 1; i < n; ++i)
+		{
+			X.square();
+			if ((i & (L - 1)) == 0) X.Gerbicz_step();
+			if (_quit) return false;
+		}
+		for (size_t lane = 0; lane < batchKs.size(); ++lane)
+			if (X.getError(lane) != 0) throw std::runtime_error("GPU error detected in native batch main loop");
+		const double mainSeconds = std::chrono::duration<double>(
+			std::chrono::steady_clock::now() - mainStart).count();
