+		const double gerbiczSeconds = std::chrono::duration<double>(
+			std::chrono::steady_clock::now() - gerbiczStart).count();
+		const double totalSeconds = std::chrono::duration<double>(
+			std::chrono::steady_clock::now() - totalStart).count();
