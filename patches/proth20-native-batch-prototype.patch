+		std::vector<uint32_t> witnesses(batchKs.size(), 0);
+		for (size_t lane = 0; lane < batchKs.size(); ++lane)
+		{
+			uint32_t divisor = 0;
+			if (!arith::proth_prime_quad_nonres(batchKs[lane], n, 3, witnesses[lane]))
+			{
+				divisor = witnesses[lane];
+				std::ostringstream ss;
+				ss << "native batch candidate " << batchKs[lane] << " * 2^" << n
+					<< " + 1 is divisible by " << divisor;
