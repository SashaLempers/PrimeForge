+		for (size_t lane = 0; lane < batchKs.size(); ++lane)
+			if (X.getError(lane) != 0) throw std::runtime_error("GPU error detected in native batch residue");
+
+		const std::chrono::steady_clock::time_point gerbiczStart = std::chrono::steady_clock::now();
+		for (uint32_t i = n; true; ++i)
+		{
+			X.square();
+			if ((i & (L - 1)) == 0)
+			{
+				X.Gerbicz_check(L);
+				break;
+			}
+		}
+		for (size_t lane = 0; lane < batchKs.size(); ++lane)
