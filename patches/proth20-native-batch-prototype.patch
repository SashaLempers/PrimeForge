+	bool checkNativeBatch(const std::vector<uint32_t> & batchKs, const uint32_t n, engine & engine)
+	{
+		if ((batchKs.size() != 2) && (batchKs.size() != 4) && (batchKs.size() != 8))
+			throw std::runtime_error("native batch prototype requires 2, 4 or 8 candidates");
+		for (size_t i = 0; i < batchKs.size(); ++i)
