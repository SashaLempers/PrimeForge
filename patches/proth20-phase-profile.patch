diff --git a/src/primeforge_profile.h b/src/primeforge_profile.h
new file mode 100644
index 0000000..4cb5961
--- /dev/null
+++ b/src/primeforge_profile.h
@@ -0,0 +1,48 @@
+/*
+PrimeForge phase instrumentation for the pinned Proth20 integration.
+SPDX-License-Identifier: Apache-2.0
+*/
+
+#pragma once
+
+#include "pio.h"
+
+#include <chrono>
+#include <cstddef>
+#include <cstdint>
+#include <sstream>
+
+namespace primeforge_profile
+{
+
+using clock = std::chrono::steady_clock;
+using time_point = clock::time_point;
+
+inline time_point now() { return clock::now(); }
+
+inline uint64_t elapsedNanoseconds(const time_point & start)
+{
+	return uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(now() - start).count());
+}
+
+inline void emitPhase(const bool enabled, const size_t candidateIndex,
+	const uint32_t k, const uint32_t n, const char * const phase, const uint64_t wallNanoseconds)
+{
+	if (!enabled) return;
+	std::ostringstream ss;
+	ss << "PRIMEFORGE_PHASE\t" << candidateIndex << "\t" << k << "\t" << n
+		<< "\t" << phase << "\t" << wallNanoseconds << std::endl;
+	pio::print(ss.str());
+}
+
+inline void emitCounter(const bool enabled, const size_t candidateIndex,
+	const uint32_t k, const uint32_t n, const char * const counter, const uint64_t value)
+{
+	if (!enabled) return;
+	std::ostringstream ss;
+	ss << "PRIMEFORGE_COUNTER\t" << candidateIndex << "\t" << k << "\t" << n
+		<< "\t" << counter << "\t" << value << std::endl;
+	pio::print(ss.str());
+}
+
+}
