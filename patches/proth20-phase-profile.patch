+	void displayProfilesMachine(const size_t candidateIndex, const uint32_t k, const uint32_t n) const
+	{
+		std::ostringstream ss;
+		for (auto it : _profileMap)
+		{
+			const profile & prof = it.second;
+			if (prof.count != 0)
+			{
+				ss << "PRIMEFORGE_KERNEL\t" << candidateIndex << "\t" << k << "\t" << n
+					<< "\t" << prof.name << "\t" << prof.count << "\t" << prof.time << std::endl;
+			}
+		}
+		pio::print(ss.str());
+	}
